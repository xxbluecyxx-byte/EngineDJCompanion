[Unit]
Description=Engine Companion track service
Wants=network-online.target
After=network-online.target enginex-stream-sync.service
ConditionPathExists=/data/sc5000-custom/bundle/bin/engine-companion-agent
ConditionPathExists=/data/sc5000-custom/state/access-token
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/data/sc5000-custom/bundle/bin/engine-companion-agent
Restart=on-failure
RestartSec=5
Nice=19

[Install]
WantedBy=multi-user.target
